{
  "name": "ink-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ink backend — auth, Neon Postgres, entitlements, payments AI (Sprint 2)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:init": "psql \"$DATABASE_URL\" -f sql/001_init.sql",
    "db:migrate": "psql \"$DATABASE_URL\" -f sql/002_crm_admin_role.sql && psql \"$DATABASE_URL\" -f sql/003_username_and_seed.sql && psql \"$DATABASE_URL\" -f sql/004_cms_pages.sql && psql \"$DATABASE_URL\" -f sql/005_cms_content_media.sql && psql \"$DATABASE_URL\" -f sql/006_cms_crew.sql",
    "db:migrate:cms": "tsx src/scripts/migrateCms.ts",
    "db:migrate:content": "tsx src/scripts/migrateContent.ts",
    "db:seed": "tsx src/scripts/seedAdmin.ts",
    "db:seed:portal": "tsx src/scripts/seedPortalContent.ts",
    "db:seed:docs": "tsx src/scripts/seedDocsContent.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@neondatabase/serverless": "^0.10.4",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
